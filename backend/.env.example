# ==============================================================================
# Fitness Tracker Backend — Ortam Değişkenleri Şablonu (Sağlayıcıdan Bağımsız)
# ==============================================================================
# Gerçek değerleri yalnızca yerel .env dosyasına veya bulut paneline girin.
# .env dosyası asla Git'e gönderilmez.

PORT=4000
NODE_ENV=development

# --- Veritabanı ---
# Yerel geliştirme (SQLite):
DATABASE_URL="file:./dev.db"
# Canlı 0 TL Model B (PostgreSQL — Neon / Supabase / Render / Docker):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"
# (İsteğe bağlı) Havuzlu bağlantı (Neon/Supabase) kullanıyorsanız şema itme için doğrudan adres:
# DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST:5432/DBNAME?sslmode=require"

# --- Oturum & Güvenlik ---
# Canlıda en az 32 karakterlik rastgele güçlü anahtar üretin (örn: openssl rand -hex 32)
JWT_SECRET="change-this-to-a-long-random-secret-in-production"
JWT_EXPIRES_IN="1d"
SESSION_TTL_DAYS=30
# Tek alan adı (SERVE_FRONTEND=true veya aynı kök alan) için "strict" (önerilen);
# Arayüz ve sunucu farklı alan adlarındaysa HTTPS ile "none" kullanılabilir.
COOKIE_SAME_SITE="strict"
# Ters proxy (Render, Koyeb, Railway, Nginx, Cloudflare) arkasında 1 yapın; yerelde 0.
TRUST_PROXY=0

# --- Kişisel Erişim Kilidi ---
# Boş bırakıldığında yerel mod (yalnızca isim); doldurulduğunda (4-64 karakter) kişisel PIN kilidi açılır.
APP_PIN=""

# --- Arayüz & CORS ---
# Birden fazla izinli adres virgülle ayrılabilir (wildcard '*' kabul edilmez).
CORS_ORIGIN="http://localhost:5173"
FRONTEND_URL="http://localhost:5173"
# Tek servis 0 TL kurulumda derlenmiş frontend/dist klasörünü backend'den sunmak için "true" yapın.
SERVE_FRONTEND="false"
# FRONTEND_DIST_DIR="../frontend/dist"

# --- Şifre Sıfırlama ---
PASSWORD_RESET_TTL_MINUTES=15
