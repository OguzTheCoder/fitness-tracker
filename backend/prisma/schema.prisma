generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(cuid())
  name                String
  email               String               @unique
  passwordHash        String
  tokenVersion        Int                  @default(0)
  isPersonalOwner     Boolean              @default(false)
  pinFingerprint      String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  profile             UserProfile?
  passwordResetTokens PasswordResetToken[]
  weightEntries       WeightEntry[]
  calorieEntries      CalorieEntry[]
  workoutEntries      WorkoutEntry[]
}

model UserProfile {
  id                    String   @id @default(cuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyCalorieGoal      Int      @default(2000)
  proteinGoalG          Int      @default(150)
  carbsGoalG            Int      @default(200)
  fatGoalG              Int      @default(65)
  dailyStepGoal         Int      @default(8000)
  visibleMicronutrients String   @default("[\"Na\",\"K\",\"Mg\",\"Ca\",\"Fe\",\"Zn\"]")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model WeightEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String
  weightKg  Float
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
}

model CalorieEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String
  mealName  String
  calories  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, date])
}

model WorkoutEntry {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date            String
  name            String
  durationMinutes Int
  note            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId, date])
}
