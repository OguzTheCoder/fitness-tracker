generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(cuid())
  name                String
  email               String               @unique
  passwordHash        String
  tokenVersion        Int                  @default(0)
  isPersonalOwner     Boolean              @default(false)
  pinFingerprint      String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  profile             UserProfile?
  passwordResetTokens PasswordResetToken[]
  weightEntries       WeightEntry[]
  calorieEntries      CalorieEntry[]
  workoutEntries      WorkoutEntry[]
  exercises           Exercise[]
  workoutTemplates    WorkoutTemplate[]
  cardioEntries       CardioEntry[]
  stepEntries         StepEntry[]
  foods               Food[]
  recipes             Recipe[]
  nutritionLogs       NutritionLog[]
}

model UserProfile {
  id                    String   @id @default(cuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyCalorieGoal      Int      @default(2000)
  proteinGoalG          Int      @default(150)
  carbsGoalG            Int      @default(200)
  fatGoalG              Int      @default(65)
  dailyStepGoal         Int      @default(8000)
  visibleMicronutrients String   @default("[\"Na\",\"K\",\"Mg\",\"Ca\",\"Fe\",\"Zn\"]")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model WeightEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String
  weightKg  Float
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
}

model CalorieEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String
  mealName  String
  calories  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, date])
}

model WorkoutEntry {
  id              String            @id @default(cuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  templateId      String?
  template        WorkoutTemplate?  @relation(fields: [templateId], references: [id], onDelete: SetNull)
  date            String
  name            String
  durationMinutes Int
  note            String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  exercises       WorkoutExercise[]

  @@index([userId, date])
  @@index([templateId])
}

model Exercise {
  id                String                    @id @default(cuid())
  userId            String?
  user              User?                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isCore            Boolean                   @default(false)
  coreKey           String?                   @unique
  name              String
  muscleGroup       String
  equipment         String?
  isBodyweight      Boolean                   @default(false)
  notes             String?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  templateExercises WorkoutTemplateExercise[]
  workoutExercises  WorkoutExercise[]

  @@index([userId, name])
  @@index([isCore, muscleGroup])
  @@index([muscleGroup])
}

model WorkoutTemplate {
  id          String                    @id @default(cuid())
  userId      String
  user        User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  exercises   WorkoutTemplateExercise[]
  workouts    WorkoutEntry[]

  @@index([userId, name])
}

model WorkoutTemplateExercise {
  id              String          @id @default(cuid())
  templateId      String
  template        WorkoutTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  exerciseId      String?
  exercise        Exercise?       @relation(fields: [exerciseId], references: [id], onDelete: SetNull)
  exerciseName    String
  muscleGroup     String?
  defaultSets     Int             @default(3)
  defaultReps     Int             @default(10)
  defaultWeightKg Float?
  sortOrder       Int             @default(0)

  @@index([templateId])
  @@index([exerciseId])
}

model WorkoutExercise {
  id           String       @id @default(cuid())
  workoutId    String
  workout      WorkoutEntry @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exerciseId   String?
  exercise     Exercise?    @relation(fields: [exerciseId], references: [id], onDelete: SetNull)
  exerciseName String
  muscleGroup  String?
  sortOrder    Int          @default(0)
  note         String?
  sets         WorkoutSet[]

  @@index([workoutId])
  @@index([exerciseId])
  @@index([exerciseName])
}

model WorkoutSet {
  id                String          @id @default(cuid())
  workoutExerciseId String
  workoutExercise   WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)
  setNumber         Int
  reps              Int
  weightKg          Float?

  @@index([workoutExerciseId])
}

model CardioEntry {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date            String
  cardioType      String
  durationMinutes Int
  distanceKm      Float?
  caloriesBurned  Int?
  note            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId, date])
}

model StepEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String
  steps     Int
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
}

model Food {
  id                    String         @id @default(cuid())
  userId                String?
  user                  User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  isCore                Boolean        @default(false)
  coreKey               String?        @unique
  barcode               String?
  name                  String
  brand                 String?
  category              String?
  servingLabel          String?
  servingGrams          Float?
  caloriesPer100g       Float
  proteinPer100g        Float
  carbsPer100g          Float
  fatPer100g            Float
  micronutrientsPer100g String         @default("{}")
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  recipeItems           RecipeItem[]
  nutritionLogs         NutritionLog[]

  @@unique([userId, barcode])
  @@index([userId, name])
  @@index([isCore, name])
  @@index([isCore, barcode])
}

model Recipe {
  id            String         @id @default(cuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  servingsCount Float          @default(1)
  cookedWeightG Float?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  items         RecipeItem[]
  nutritionLogs NutritionLog[]

  @@index([userId, name])
}

model RecipeItem {
  id        String @id @default(cuid())
  recipeId  String
  recipe    Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  foodId    String
  food      Food   @relation(fields: [foodId], references: [id], onDelete: Cascade)
  grams     Float
  sortOrder Int    @default(0)

  @@index([recipeId])
  @@index([foodId])
}

model NutritionLog {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date           String
  mealLabel      String?
  sourceType     String
  foodId         String?
  food           Food?    @relation(fields: [foodId], references: [id], onDelete: SetNull)
  recipeId       String?
  recipe         Recipe?  @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  entryName      String
  quantityMode   String
  servings       Float?
  grams          Float
  calories       Float
  proteinG       Float
  carbsG         Float
  fatG           Float
  micronutrients String   @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId, date])
}
